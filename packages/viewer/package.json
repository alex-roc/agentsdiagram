{
  "name": "@agentsdiagram/viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Graph viewer (React Flow) for agentsdiagram; one bundle for the VS Code webview and the standalone HTML",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node scripts/copy-static.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agentsdiagram/protocol": "workspace:*",
    "@dagrejs/dagre": "^3.1.0",
    "@xyflow/react": "12.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
