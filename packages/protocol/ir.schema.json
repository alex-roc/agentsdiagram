{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "ref",
        "node_id"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "uses",
            "provides",
            "wraps",
            "delegates_to",
            "manages",
            "runs",
            "contains",
            "transitions"
          ],
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Call order for `runs` edges"
        },
        "wrappers": {
          "description": "Toolset wrappers applied on this edge, e.g. prefixed('x')",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where this relation is written"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "label",
        "order",
        "wrappers",
        "ref"
      ],
      "title": "Edge",
      "type": "object"
    },
    "FileInfo": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "frameworks": {
          "items": {
            "enum": [
              "pydantic_ai",
              "smolagents"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "default": "ok",
          "enum": [
            "ok",
            "stale",
            "error"
          ],
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "module",
        "frameworks",
        "status",
        "sha256"
      ],
      "title": "FileInfo",
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "tool",
            "toolset",
            "mcp_server",
            "native_tool",
            "capability",
            "workflow",
            "external_tool_source",
            "graph",
            "graph_step",
            "dynamic"
          ],
          "type": "string"
        },
        "framework": {
          "enum": [
            "pydantic_ai",
            "smolagents"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "default": "resolved",
          "enum": [
            "resolved",
            "partial",
            "dynamic",
            "planned",
            "stale"
          ],
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attrs": {
          "$ref": "#/$defs/NodeAttrs"
        }
      },
      "required": [
        "id",
        "kind",
        "framework",
        "name",
        "status",
        "source",
        "attrs"
      ],
      "title": "Node",
      "type": "object"
    },
    "NodeAttrs": {
      "additionalProperties": false,
      "description": "Typed attributes that are stable across library versions. Everything else goes to ``extra``.",
      "properties": {
        "agent_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dynamic_instructions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "deps_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "docstring": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "takes_ctx": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "badges": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "extra": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "agent_class",
        "model",
        "instructions",
        "dynamic_instructions",
        "description",
        "output_type",
        "deps_type",
        "docstring",
        "signature",
        "takes_ctx",
        "url",
        "command",
        "badges",
        "extra"
      ],
      "title": "NodeAttrs",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "description": "1-based line",
          "type": "integer"
        },
        "column": {
          "description": "0-based column, in code points",
          "type": "integer"
        }
      },
      "required": [
        "line",
        "column"
      ],
      "title": "Position",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/Position"
        },
        "end": {
          "$ref": "#/$defs/Position"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Range",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "POSIX path relative to the project root",
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/Range"
        },
        "name_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Range of the identifier (variable, function or class name)"
        }
      },
      "required": [
        "file",
        "range",
        "name_range"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "AddAgent": {
      "additionalProperties": false,
      "description": "Write a new (planned) agent. With ``parent`` it is wired to an existing agent:\na managed agent in smolagents, a delegation tool in PydanticAI.",
      "properties": {
        "op": {
          "const": "add_agent",
          "type": "string"
        },
        "framework": {
          "enum": [
            "pydantic_ai",
            "smolagents"
          ],
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "file": {
          "description": "POSIX path relative to the project root; created if missing",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "instructions": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "agent_class": {
          "anyOf": [
            {
              "enum": [
                "CodeAgent",
                "ToolCallingAgent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "smolagents only"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Node id of the agent that manages / delegates to it"
        }
      },
      "required": [
        "op",
        "framework",
        "name",
        "file"
      ],
      "title": "AddAgent",
      "type": "object"
    },
    "AddMcp": {
      "additionalProperties": false,
      "description": "Connect an MCP server (URL or stdio command) to an agent.",
      "properties": {
        "op": {
          "const": "add_mcp",
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shell-style command line, e.g. 'uvx arxiv-mcp-server'"
        }
      },
      "required": [
        "op",
        "agent"
      ],
      "title": "AddMcp",
      "type": "object"
    },
    "AddTool": {
      "additionalProperties": false,
      "description": "Write a planned tool stub and give it to an agent.",
      "properties": {
        "op": {
          "const": "add_tool",
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "params": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Parameter list, e.g. 'order_id: str, limit: int = 5'"
        },
        "returns": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "op",
        "agent",
        "name"
      ],
      "title": "AddTool",
      "type": "object"
    },
    "Connect": {
      "additionalProperties": false,
      "description": "Let ``source`` hand work to ``target``: managed_agents (smolagents) or a delegation tool (PydanticAI).",
      "properties": {
        "op": {
          "const": "connect",
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "smolagents: description added to the target if missing"
        }
      },
      "required": [
        "op",
        "source",
        "target"
      ],
      "title": "Connect",
      "type": "object"
    },
    "Disconnect": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "disconnect",
          "type": "string"
        },
        "edge": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "edge"
      ],
      "title": "Disconnect",
      "type": "object"
    },
    "EditParams": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "discriminator": {
            "mapping": {
              "add_agent": "#/$defs/AddAgent",
              "add_mcp": "#/$defs/AddMcp",
              "add_tool": "#/$defs/AddTool",
              "connect": "#/$defs/Connect",
              "disconnect": "#/$defs/Disconnect",
              "export_spec": "#/$defs/ExportSpec",
              "remove": "#/$defs/Remove",
              "set_instructions": "#/$defs/SetInstructions",
              "set_model": "#/$defs/SetModel"
            },
            "propertyName": "op"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AddAgent"
            },
            {
              "$ref": "#/$defs/AddTool"
            },
            {
              "$ref": "#/$defs/AddMcp"
            },
            {
              "$ref": "#/$defs/Connect"
            },
            {
              "$ref": "#/$defs/Disconnect"
            },
            {
              "$ref": "#/$defs/Remove"
            },
            {
              "$ref": "#/$defs/SetModel"
            },
            {
              "$ref": "#/$defs/SetInstructions"
            },
            {
              "$ref": "#/$defs/ExportSpec"
            }
          ]
        },
        "expect": {
          "description": "The files as the diagram saw them; the edit is refused if one changed since",
          "items": {
            "$ref": "#/$defs/FileVersion"
          },
          "type": "array"
        }
      },
      "required": [
        "request"
      ],
      "title": "EditParams",
      "type": "object"
    },
    "EditResult": {
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "files": {
          "description": "Files changed or created",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "focus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id of the node to select once the graph is redrawn"
        }
      },
      "required": [
        "ok",
        "message",
        "files",
        "focus"
      ],
      "title": "EditResult",
      "type": "object"
    },
    "ExportSpec": {
      "additionalProperties": false,
      "description": "PydanticAI: move an agent's literal settings to an Agent Spec (YAML).",
      "properties": {
        "op": {
          "const": "export_spec",
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Spec file relative to the project root"
        },
        "replace": {
          "default": true,
          "description": "Rewrite the code to load the spec with Agent.from_file",
          "type": "boolean"
        }
      },
      "required": [
        "op",
        "agent"
      ],
      "title": "ExportSpec",
      "type": "object"
    },
    "FileVersion": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "POSIX path relative to the project root",
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
      "title": "FileVersion",
      "type": "object"
    },
    "Remove": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "remove",
          "type": "string"
        },
        "node": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "node"
      ],
      "title": "Remove",
      "type": "object"
    },
    "SetInstructions": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "set_instructions",
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "instructions": {
          "description": "Empty removes them",
          "type": "string"
        }
      },
      "required": [
        "op",
        "agent",
        "instructions"
      ],
      "title": "SetInstructions",
      "type": "object"
    },
    "SetModel": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "set_model",
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "required": [
        "op",
        "agent",
        "model"
      ],
      "title": "SetModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ir_version": {
      "default": "1",
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "frameworks": {
      "items": {
        "enum": [
          "pydantic_ai",
          "smolagents"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileInfo"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/Node"
      },
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "type": "array"
    }
  },
  "required": [
    "ir_version",
    "tool_version",
    "root",
    "frameworks",
    "files",
    "nodes",
    "edges",
    "diagnostics"
  ],
  "title": "Project",
  "type": "object"
}
